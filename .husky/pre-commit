#!/usr/bin/env sh
# Lovable / 0WEB pre-commit hook.

# Bloqueia alterações acidentais na identidade institucional antes que elas
# cheguem ao build/CI. Não há bypass: exceções exigem autorização explícita e
# atualização auditada do manifesto conforme docs/BRAND_ASSET_POLICY.md.
echo "[pre-commit] validating institutional brand integrity..."
node scripts/validate-brand-integrity.mjs
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "✖ Pre-commit bloqueado: a zona institucional congelada foi alterada."
  echo "  Restaure os arquivos protegidos ou siga a exceção formal da política de marca."
  exit $status
fi

# Allow bypass: SKIP_SEO_IMAGE_CHECK=1 git commit ...
if [ "$SKIP_SEO_IMAGE_CHECK" != "1" ]; then
  echo "[pre-commit] validating SEO images..."
  SEO_PRECOMMIT=1 node scripts/validate-seo-images.mjs
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "✖ Pre-commit bloqueado: og:image/twitter:image ou max-image-preview:large inválidos."
    echo "  Corrija as imagens/metas ou rode com SKIP_SEO_IMAGE_CHECK=1 para pular."
    exit $status
  fi
fi

# Validate JSON-LD schemas (Organization/LocalBusiness/WebSite/Review/...).
if [ "$SKIP_SCHEMA_VALIDATION" != "1" ]; then
  echo "[pre-commit] validating Schema.org JSON-LD..."
  node scripts/validate-schemas.mjs
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "✖ Pre-commit bloqueado: rich results inconsistentes."
    echo "  Corrija os blocos JSON-LD ou rode com SKIP_SCHEMA_VALIDATION=1 para pular."
    exit $status
  fi
fi

# Validate canonical tags in route files.
if [ "$SKIP_CANONICAL_CHECK" != "1" ]; then
  echo "[pre-commit] validating canonicals..."
  node scripts/validate-canonicals.mjs
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "✖ Pre-commit bloqueado: canonicals inconsistentes."
    echo "  Corrija os links rel=canonical ou rode com SKIP_CANONICAL_CHECK=1 para pular."
    exit $status
  fi
fi

# Validate route file references vs routeTree.gen.ts.
if [ "$SKIP_ROUTE_FILES_CHECK" != "1" ]; then
  echo "[pre-commit] validating route files..."
  node scripts/validate-route-files.mjs
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "✖ Pre-commit bloqueado: arquivos de rota ausentes."
    echo "  Corrija as rotas ou rode com SKIP_ROUTE_FILES_CHECK=1 para pular."
    exit $status
  fi
fi

exit 0

