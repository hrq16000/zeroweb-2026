{
  "version": 6,
  "mode": "ZERO_GENERIC_TOLERANCE",
  "canonicalDoc": "docs/PORTFOLIO_ZERO_GENERIC_STANDARD.md",
  "scope": {
    "appliesToAllPortfolioProjects": true,
    "includesExistingProjects": true,
    "includesNewProjects": true,
    "includesMaterialMaintenance": true,
    "surfaces": [
      "portfolio-route",
      "catalog-card",
      "catalog-cover",
      "preview-modal",
      "viewer-iframe",
      "editor-preview",
      "pr-preview",
      "hero",
      "social-og",
      "thumbnail",
      "share-media",
      "funnel-ui",
      "mobile",
      "tablet",
      "desktop",
      "reduced-motion",
      "ab-variant",
      "campaign-derivative",
      "own-domain-promotion"
    ]
  },
  "skillPolicy": {
    "discoveryRequired": true,
    "searchLocalRegistry": true,
    "searchOriginalSources": true,
    "searchLobeHub": true,
    "searchAwesomeSkill": true,
    "awesomeSkillSearchUrl": "https://awesomeskill.ai/search",
    "maximumRelevantNonRedundant": true,
    "securityReviewBeforeExecution": true,
    "neverInstallDuringBuild": true,
    "requiredLayers": [
      "strategy",
      "entity-research",
      "art-direction",
      "ui-ux",
      "layout-engineering",
      "design-system",
      "conversion",
      "motion",
      "accessibility",
      "react-performance",
      "seo-content",
      "privacy-security",
      "browser-qa"
    ]
  },
  "creativePolicy": {
    "minimumDivergentDirectionsBeforeFinal": 3,
    "noPresetAsFinalDirection": true,
    "noSharedVisualSkeleton": true,
    "noBrandTestRequired": true,
    "neighborComparisonRequired": true,
    "compositionFingerprintRequired": true,
    "signatureMomentRequired": true,
    "experienceRoleMatrixRequired": true,
    "rhythmMediaMatrixRequired": true,
    "journeyDivergenceRequired": true,
    "referenceDecompositionRequiredWhenReferenceSupplied": true,
    "referenceMustNotDefineFinalSilhouette": true,
    "primaryExperienceEngineRequired": true,
    "maximumStrongExperienceEngines": 2,
    "segmentDefaultEngineForbidden": true,
    "engineMustChangeComposition": true
  },
  "mediaPolicy": {
    "purposeSlots": [
      "hero",
      "catalogCover",
      "socialOg",
      "preview"
    ],
    "mediaStrategyRequired": true,
    "generatedContextualMediaAllowed": true,
    "fabricatedEvidenceForbidden": true,
    "mediaStarvationIsFailure": true
  },
  "layoutPolicy": {
    "requiredAssessment": [
      "flexbox",
      "css-grid",
      "intrinsic-sizing",
      "responsive-flow"
    ],
    "viewports": [
      390,
      768,
      1440
    ],
    "semanticOrderRequired": true,
    "horizontalOverflowForbidden": true
  },
  "motionPolicy": {
    "assessmentRequired": true,
    "capabilities": [
      "fade-up",
      "fade-left/right",
      "blur-in",
      "scale-in",
      "stagger-up",
      "image-reveal",
      "clip-reveal",
      "parallax",
      "marquee",
      "float",
      "header-scroll",
      "menu-reveal",
      "text-line-reveal",
      "progress-line"
    ],
    "reducedMotionRequired": true,
    "maximumRelevantNotMaximumEffects": true
  },
  "hardBlockers": [
    "SKILL_DISCOVERY_SKIPPED",
    "GENERIC_COMPOSITION",
    "SHARED_VISUAL_SKELETON",
    "SKIN_SWAP",
    "REUSED_HERO_GEOMETRY_WITHOUT_JUSTIFICATION",
    "DEFAULT_SECTION_ORDER",
    "DEFAULT_TYPOGRAPHY_WITHOUT_BRAND_REASON",
    "REPEATED_GRID_TOPOLOGY",
    "REPEATED_MOTION_GRAMMAR",
    "NO_SIGNATURE_MOMENT",
    "MEDIA_STARVATION",
    "CATALOG_COVER_GENERIC",
    "PREVIEW_ASSET_DRIFT",
    "OG_DIRECTION_DRIFT",
    "MOBILE_GENERIC_COLLAPSE",
    "REDUCED_MOTION_BROKEN",
    "NO_BRAND_TEST_FAIL",
    "HIGH_SIMILARITY_UNRESOLVED",
    "VISUAL_QA_MISSING",
    "REFERENCE_DECOMPOSITION_MISSING",
    "REFERENCE_USED_AS_TEMPLATE",
    "SAME_JOURNEY_DIFFERENT_COPY",
    "SECTION_ROLE_MONOTONY",
    "MEDIA_RHYTHM_REUSED",
    "FUNCTIONAL_DIVERSITY_MISSING",
    "NEW_UNMANAGED_PORTFOLIO",
    "SCOPE_OVERCLAIM",
    "MATERIAL_LIMIT_HIDDEN",
    "STALE_DECISION_DATA",
    "FAKE_LIVE_AVAILABILITY",
    "VOLATILE_CLAIM_WITHOUT_SOURCE",
    "ENGINELESS_COMPLETE_SITE",
    "ENGINE_STACKING",
    "SEGMENT_ENGINE_DEFAULT",
    "ENGINE_DECORATIVE_ONLY"
  ],
  "legacyPolicy": {
    "grandfatheredAsComplete": false,
    "mayRemainPublishedDuringRemediation": true,
    "fullPolicyAppliesOnMaterialMaintenance": true,
    "priorityOrder": [
      "HIGH_SIMILARITY",
      "ATTENTION",
      "weak-media-cover",
      "generic-hero",
      "missing-signature"
    ],
    "baselineFile": "src/config/portfolio-legacy-baseline.json",
    "baselineFrozen": true,
    "newProjectsMustBeManaged": true,
    "legacyCountMayOnlyDecrease": true
  },
  "referenceDecompositionPolicy": {
    "requiredWhenReferenceSupplied": true,
    "matrices": [
      "ROLE_MATRIX",
      "COMPOSITION_MATRIX",
      "RHYTHM_MEDIA_MATRIX",
      "ANTI_COPY_MATRIX"
    ],
    "requiredOutputs": [
      "referenceUrl",
      "reviewedRoutes",
      "rolePatterns",
      "mediaPatterns",
      "rhythmPatterns",
      "interactionPatterns",
      "decisionPatterns",
      "transferablePrinciples",
      "doNotCopy",
      "projectSpecificTranslation"
    ],
    "principle": "ABSORB_GRAMMAR_NEVER_COPY_SILHOUETTE"
  },
  "truthPolicy": {
    "scopeTruthMatrixRequired": true,
    "freshnessMatrixRequiredForVolatileDecisionData": true,
    "limitsMustBeVisibleBeforeConversionWhenMaterial": true,
    "staleDecisionDataForbidden": true,
    "fakeLiveAvailabilityForbidden": true,
    "volatileClaimsRequireSourceAndVerifiedAt": true
  },
  "referenceGovernanceDoc": "docs/PORTFOLIO_REFERENCE_COMPOSITION_GOVERNANCE_STANDARD.md",
  "referenceGovernanceStatus": "CANONICAL_ADDITIVE_REQUIRED",
  "referenceCorpus": {
    "patternLibrary": "src/config/portfolio-reference-pattern-library.json",
    "selectionMode": "DECISION_MODE_NOT_SEGMENT",
    "preferredReferenceCount": "2-4",
    "useClasses": [
      "USE",
      "ADAPT",
      "REJECT"
    ],
    "motionRequiresVisualEvidence": true,
    "researchLedgers": [
      "docs/research/PORTFOLIO_REFERENCE_CORPUS_R1_2026-09-23.md",
      "docs/research/PORTFOLIO_REFERENCE_CORPUS_R2_2026-09-23.md",
      "docs/research/PORTFOLIO_REFERENCE_CORPUS_R3_2026-09-23.md",
      "docs/research/PORTFOLIO_REFERENCE_CORPUS_R4_2026-09-23.md"
    ]
  },
  "experienceEnginePolicy": {
    "primaryRequiredForNewProjects": true,
    "counterpointOptionalMaximum": 1,
    "sourceLibrary": "src/config/portfolio-reference-pattern-library.json",
    "researchLedgers": [
      "docs/research/PORTFOLIO_REFERENCE_CORPUS_R1_2026-09-23.md",
      "docs/research/PORTFOLIO_REFERENCE_CORPUS_R2_2026-09-23.md",
      "docs/research/PORTFOLIO_REFERENCE_CORPUS_R3_2026-09-23.md",
      "docs/research/PORTFOLIO_REFERENCE_CORPUS_R4_2026-09-23.md"
    ],
    "engineMustBeEvidenceDriven": true,
    "engineMustAffectAtLeastTwoAxes": [
      "contentOrder",
      "composition",
      "mediaCadence",
      "interactionLoci",
      "ctaDistribution",
      "mobileCompositionStrategy"
    ]
  },
  "interactionSignaturePolicy": {
    "sourceLibrary": "src/config/portfolio-reference-pattern-library.json",
    "mustSolveRealDecision": true,
    "mustBeEvidenceDriven": true,
    "mustNotBecomeSegmentDefault": true,
    "maximumRelevantNotMaximumCount": true,
    "privacyByMinimization": true,
    "unresolvedReferenceMustNotBeSubstituted": true,
    "mustChangeJourneyOrContext": true,
    "contextCarryoverRequiredWhenSelectionMatters": true,
    "multiNeedScopeBuilderSingleFunnelRequired": true,
    "consolidatedProviderClaimsRequireEvidence": true,
    "consolidatedProviderMustNotImplyUnverifiedSimultaneousAvailability": true,
    "reuseExistingBlockersBeforeAddingNewOnes": true
  }
}
